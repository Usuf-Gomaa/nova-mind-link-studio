{
  "name": "nova-mind-link-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack dynamic QR link hub with an authenticated admin dashboard, local persistence and Cloudflare Workers + D1 hosting.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test local/api.test.mjs hosting/worker.test.mjs",
    "test:hosted": "node --test hosting/worker.test.mjs",
    "build:hosted": "node hosting/build.mjs",
    "deploy:hosted": "node hosting/deploy.mjs",
    "build:pages": "node local/build-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "qr-code-styling": "1.9.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
