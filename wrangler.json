{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-mind-links",
  "main": "hosting/worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-mind-links",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "hosting/migrations"
    }
  ]
}
